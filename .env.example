# Optional. WalletConnect Cloud project id (cloud.reown.com). Without it the WalletConnect option is hidden.
NEXT_PUBLIC_WC_PROJECT_ID=
# Optional. Base RPC used for wallet balance reads. Defaults to the public Base RPC.
NEXT_PUBLIC_BASE_RPC=
# Where the deposit / invest / borrow buttons send people until the new transaction flows ship.
NEXT_PUBLIC_LEGACY_APP_URL=https://ultraroundmoney.com
# Shows the "preview" bar at the top. Set to 0 when this becomes the real site.
NEXT_PUBLIC_PREVIEW_BANNER=1
